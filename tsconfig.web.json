{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["vite/client"], "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "tests/unit/**/*.tsx"]
}
